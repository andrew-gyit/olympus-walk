{
  "name": "olympus-walk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OLYMPUS WALK — Explore smarter. Walk safer. Discover Mars.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "check:structure": "node scripts/verify-structure.mjs",
    "build:singlefile": "npm run build && node scripts/build-singlefile.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "@react-three/fiber": "8.17.10",
    "@react-three/drei": "9.117.3",
    "@dimforge/rapier3d-compat": "0.12.0",
    "zustand": "4.5.5",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "vite": "5.4.11",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "tailwindcss": "3.4.17",
    "postcss": "8.4.49",
    "autoprefixer": "10.4.20"
  }
}
